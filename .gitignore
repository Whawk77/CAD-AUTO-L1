# Build outputs
bin/
obj*/
.vs/

# Editor / OS junk
*.user
*.suo
*.cache
*.log
_system~.ini
Thumbs.db
Desktop.ini

# Compiled binaries (plugin outputs live under bin/)
*.dll
*.pdb
*.exe

# Runtime diagnostics (local CAD runs; do not commit)
diagnostics/last-run.json
diagnostics/*.json

# graphify: keep query graph + report + labels + manifest; ignore caches/viz/local paths/backups
graphify-out/cache/
graphify-out/graph.html
graphify-out/cost.json
graphify-out/.graphify_python
graphify-out/.graphify_root
graphify-out/.graphify_detect.json
graphify-out/.graphify_extract.json
graphify-out/.graphify_ast.json
graphify-out/.graphify_semantic.json
graphify-out/.graphify_analysis.json
graphify-out/.graphify_chunk_*.json
graphify-out/.graphify_cached.json
graphify-out/.graphify_uncached.txt
graphify-out/.graphify_semantic_new.json
graphify-out/.needs_update
# Dated snapshot folders under graphify-out (e.g. 2026-07-20/)
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# Local-only tooling and large unrelated trees (keep on disk, out of git status)
tools/
autocad-net-c-autocad-autocad-net-source-backup-*/

# Python bytecode if tools/ ever partially tracked
__pycache__/
*.pyc
