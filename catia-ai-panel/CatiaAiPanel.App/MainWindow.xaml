<Window x:Class="CatiaAiPanel.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CATIA AI" Width="420" MinWidth="320" MaxWidth="700" MinHeight="540"
        Background="{StaticResource PanelBackground}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="Manual">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="2,2,2,10">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="CATIA AI" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="CATIA V5 · Codex CLI" Foreground="{StaticResource MutedBrush}" FontSize="11" />
            </StackPanel>
            <Button Grid.Column="1" Content="取消" Command="{Binding CancelCommand}" VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="{Binding Status}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ContextSummary}" Foreground="{StaticResource MutedBrush}" FontSize="11"
                           Margin="0,5,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="7" Margin="0,0,0,8">
            <ListBox ItemsSource="{Binding Messages}" Background="Transparent" BorderThickness="0" Padding="5"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#20242D" CornerRadius="6" Padding="9" Margin="2,3">
                            <StackPanel>
                                <TextBlock Text="{Binding Role}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" FontSize="11" />
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <TabControl Grid.Row="3" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderBrush}"
                    Foreground="{StaticResource TextBrush}" Margin="0,0,0,8">
            <TabItem Header="宏预览">
                <Grid Background="{StaticResource CardBackground}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
                    <TextBlock Text="{Binding ProposalSummary}" TextWrapping="Wrap" Padding="9" />
                    <TextBox Grid.Row="1" Text="{Binding MacroCode, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas"
                             FontSize="12" AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                </Grid>
            </TabItem>
            <TabItem Header="风险与影响">
                <ScrollViewer Background="{StaticResource CardBackground}" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock Text="风险" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                        <TextBlock Text="{Binding RiskSummary}" TextWrapping="Wrap" Margin="0,4,0,12" />
                        <TextBlock Text="预期影响" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                        <TextBlock Text="{Binding EffectsSummary}" TextWrapping="Wrap" Margin="0,4,0,12" />
                        <TextBlock Text="验证建议" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                        <TextBlock Text="{Binding VerificationSummary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="测量账本">
                <ScrollViewer Background="{StaticResource CardBackground}"
                              VerticalScrollBarVisibility="Visible"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly">
                <Grid Background="{StaticResource CardBackground}" Margin="8,8,4,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="{Binding ReadinessSummary}" TextWrapping="Wrap" />
                        <Border Background="#15181E" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="7" Margin="0,8,0,0" MaxHeight="170">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <TextBlock Text="{Binding MeasuredDimensionsSummary}" TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Border>
                        <Border Background="#20242D" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="7" Margin="0,8,0,0">
                            <TextBlock Text="{Binding ModelingBlockerSummary}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                    <Border Grid.Row="1" Background="#20242D" CornerRadius="5" Padding="7" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="引导式原生测量" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding GuidedMeasurementStatus}" TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,3,0,5" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding GuidedMeasurementTypes}"
                                          SelectedValuePath="Key"
                                          SelectedValue="{Binding GuidedMeasurementName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          ToolTip="先选择本次测量的建模语义，再启动 CATIA 原生测量">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Label}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="1" Content="开始并自动记录" Command="{Binding StartGuidedMeasurementCommand}" />
                                <Button Grid.Column="2" Content="清空当前" Command="{Binding ClearGuidedMeasurementCommand}"
                                        ToolTip="取消当前引导并清空当前选择；不会删除已经确认写入的测量账本" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <ListBox Grid.Row="2" ItemsSource="{Binding Measurements}"
                             SelectedItem="{Binding SelectedMeasurement, Mode=TwoWay}"
                             Background="#11141A" BorderBrush="{StaticResource BorderBrush}"
                             MinHeight="180" Height="230">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Quantity}" Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock Text=" = " />
                                        <TextBlock Text="{Binding Value}" />
                                        <TextBlock Text=" " />
                                        <TextBlock Text="{Binding Unit}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="3" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding MeasurementSemanticName, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="例如 overall_length、overall_width、overall_height、hole_01_diameter" />
                            <Button Grid.Column="1" Content="保存语义名称" Command="{Binding RenameMeasurementCommand}" />
                        </Grid>
                        <WrapPanel HorizontalAlignment="Right">
                            <Button Content="删除选中" Click="DeleteMeasurement_Click"
                                    ToolTip="删除列表中选中的一条测量尺寸" />
                            <Button Content="清空全部" Click="ClearMeasurements_Click" Background="#8F3340"
                                    ToolTip="清空当前文档的全部本地测量尺寸" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="4">
            <TextBox Text="{Binding Feedback, UpdateSourceTrigger=PropertyChanged}" MinHeight="44" AcceptsReturn="True"
                     TextWrapping="Wrap" ToolTip="执行结果不符合预期时，在这里描述如何修正" />
            <CheckBox Content="允许用实测尺寸自动补齐未测尺寸（补齐值标记为 AI_INFERRED）"
                      IsChecked="{Binding AllowDimensionInference}" Margin="4,5,0,2"
                      ToolTip="关闭后，缺少关键尺寸时只列出待测项，不生成近似建模宏" />
            <WrapPanel HorizontalAlignment="Right">
                <Button Content="测量项目" Command="{Binding NativeMeasureCommand}" />
                <Button Content="测量距离" Command="{Binding NativeMeasureBetweenCommand}" />
                <Button Content="同步测量记录" Command="{Binding SyncMeasurementsCommand}" />
                <Button Content="分析/自动建模" Command="{Binding PrepareReconstructionCommand}"
                        Background="{StaticResource PrimaryBrush}" FontWeight="SemiBold" />
                <Button Content="复制代码" Click="CopyCode_Click" />
                <Button Content="拒绝" Command="{Binding RejectCommand}" />
                <Button Content="继续修正" Command="{Binding ContinueCommand}" />
                <Button Content="确认执行" Click="ConfirmExecute_Click" IsEnabled="{Binding CanExecute}"
                        Background="{StaticResource PrimaryBrush}" FontWeight="SemiBold" />
            </WrapPanel>
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox Text="{Binding UserPrompt, UpdateSourceTrigger=PropertyChanged}" MinHeight="54" AcceptsReturn="True"
                         TextWrapping="Wrap" ToolTip="描述希望对当前 CATIA 选择执行的任务" />
                <Button Grid.Column="1" Content="发送" Command="{Binding SubmitCommand}" Width="66"
                        Background="{StaticResource PrimaryBrush}" FontWeight="SemiBold" />
            </Grid>
        </StackPanel>
    </Grid>
</Window>
